{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cios.local/schemas/knowledge-packs/twin-release-manifest-v2.schema.json",
  "title": "CIOS Composite Industry Twin Knowledge Pack Release Manifest",
  "description": "Versioned successor to v1 for reproducible profile-conformant Industry Twin composition. It does not change v1 releases.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release", "industry_twin", "profile_versions", "objects", "memberships", "relationships", "snapshots", "validation", "supersession", "checksums"],
  "properties": {
    "schema_version": { "const": "2.0" },
    "release": {
      "type": "object", "additionalProperties": false,
      "required": ["release_id", "release_version", "released_at", "governance_state", "source_cut_off", "release_notes"],
      "properties": {
        "release_id": { "$ref": "#/$defs/id" }, "release_version": { "$ref": "#/$defs/version" },
        "released_at": { "type": "string", "format": "date-time" },
        "governance_state": { "enum": ["candidate", "accepted-pack", "canonical-promoted", "superseded", "rejected", "quarantined"] },
        "source_cut_off": { "type": "string", "format": "date" }, "release_notes": { "type": "string", "minLength": 1 }
      }
    },
    "industry_twin": {
      "type": "object", "additionalProperties": false,
      "required": ["twin_id", "twin_version", "profile_id", "profile_version"],
      "properties": {
        "twin_id": { "$ref": "#/$defs/id" }, "twin_version": { "$ref": "#/$defs/version" },
        "profile_id": { "const": "industry-overview" }, "profile_version": { "$ref": "#/$defs/version" }
      }
    },
    "profile_versions": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/$defs/profilePin" }
    },
    "objects": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/$defs/objectPin" }
    },
    "memberships": {
      "type": "object", "additionalProperties": false,
      "required": ["membership_set_version", "items"],
      "properties": {
        "membership_set_version": { "$ref": "#/$defs/version" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/membershipPin" } }
      }
    },
    "relationships": {
      "type": "object", "additionalProperties": false,
      "required": ["relationship_set_version", "locator", "checksum"],
      "properties": {
        "relationship_set_version": { "$ref": "#/$defs/version" }, "locator": { "$ref": "#/$defs/locator" }, "checksum": { "$ref": "#/$defs/checksum" }
      }
    },
    "snapshots": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_snapshot_ref", "unknown_snapshot_refs", "contradiction_snapshot_refs", "completeness_projection_version"],
      "properties": {
        "evidence_snapshot_ref": { "$ref": "#/$defs/id" },
        "unknown_snapshot_refs": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "contradiction_snapshot_refs": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "completeness_projection_version": { "$ref": "#/$defs/version" }
      }
    },
    "validation": {
      "type": "object", "additionalProperties": false,
      "required": ["profile_validation", "referential_integrity", "lineage_validation", "release_pin_integrity"],
      "properties": {
        "profile_validation": { "const": "passed" }, "referential_integrity": { "const": "passed" },
        "lineage_validation": { "const": "passed" }, "release_pin_integrity": { "const": "passed" }
      }
    },
    "supersession": {
      "type": "object", "additionalProperties": false,
      "required": ["supersedes", "rollback_reference"],
      "properties": {
        "supersedes": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "rollback_reference": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }
      }
    },
    "checksums": { "const": "checksums.sha256" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "locator": { "type": "string", "minLength": 1 },
    "checksum": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "profilePin": {
      "type": "object", "additionalProperties": false, "required": ["profile_id", "profile_version"],
      "properties": { "profile_id": { "$ref": "#/$defs/id" }, "profile_version": { "$ref": "#/$defs/version" } }
    },
    "objectPin": {
      "type": "object", "additionalProperties": false,
      "required": ["object_id", "object_type", "object_version", "profile_id", "profile_version", "canonical_owner", "content_mode", "effective_date", "locator", "checksum"],
      "properties": {
        "object_id": { "$ref": "#/$defs/id" }, "object_type": { "enum": ["industry", "enterprise", "market_participant", "programme", "opportunity", "reinvention_assessment", "relationship"] },
        "object_version": { "$ref": "#/$defs/version" }, "profile_id": { "$ref": "#/$defs/id" }, "profile_version": { "$ref": "#/$defs/version" },
        "canonical_owner": { "$ref": "#/$defs/id" }, "content_mode": { "enum": ["embedded_release", "immutable_snapshot", "materialised_projection", "external_dependency"] },
        "effective_date": { "type": "string", "format": "date" }, "locator": { "$ref": "#/$defs/locator" }, "checksum": { "$ref": "#/$defs/checksum" }
      }
    },
    "membershipPin": {
      "type": "object", "additionalProperties": false,
      "required": ["relationship_id", "relationship_version", "industry_twin_id", "member_id", "member_type", "role", "why_included", "effective_from", "effective_to", "evidence_refs", "resolved_version"],
      "properties": {
        "relationship_id": { "$ref": "#/$defs/id" }, "relationship_version": { "$ref": "#/$defs/version" }, "industry_twin_id": { "$ref": "#/$defs/id" },
        "member_id": { "$ref": "#/$defs/id" }, "member_type": { "enum": ["enterprise", "market_participant", "programme", "opportunity", "relationship"] },
        "role": { "$ref": "#/$defs/id" }, "why_included": { "$ref": "#/$defs/id" }, "effective_from": { "type": "string", "format": "date" },
        "effective_to": { "type": ["string", "null"], "format": "date" }, "evidence_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
        "resolved_version": { "$ref": "#/$defs/version" }
      }
    }
  }
}
