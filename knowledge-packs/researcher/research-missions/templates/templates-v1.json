        "industry-overview",
        "enterprise-dossier",
        "market-participant",
        "programme",
        "opportunity",
        "reinvention-assessment",
        "industry-membership",
        "industry-release-manifest"
      ],
      "modules": [
        "twin-object-construction",
        "evidence-collection",
        "evidence-closure",
        "evidence-exhaustion",
        "unknown",
        "contradiction",
        "monitoring-trigger",
        "falsification",
        "pre-delivery-validation",
        "mission-outcome"
      ],
      "required_manifest_fields": [
        "baseline_release",
        "scope.industry",
        "scope.geography",
        "evidence_policy.evidence_exhaustion_policy",
        "outputs.required_package_name"
      ],
      "required_outputs": [
        "contradiction-register",
        "evidence-register",
        "governed-records",
        "unknown-register",
        "validation-report"
      ],
      "outcome_states": [
        "CONTINUE",
        "EVIDENCE_EXHAUSTED",
        "COMPLETE"
      ],
      "validation": [
        "validate manifest and all version pins",
        "validate governed records against pinned profiles",
        "validate receipts and no unresolved variables"
      ],
      "exclusions": [
        "no industry-specific subjects",
        "no Twin truth, completeness, import or promotion decision"
      ],
      "compatibility": {
        "manifest_versions": [
          "1.1.0"
        ],
        "profile_versions": "1.x",
        "pack_versions": ">=2.8.0 <3.0.0"
      },
      "supersession": "active",
      "migration": "Regenerate when any pinned version changes; never alter this version in place."
