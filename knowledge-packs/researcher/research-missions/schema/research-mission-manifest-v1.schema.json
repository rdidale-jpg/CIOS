{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "CIOS-Research-Mission-Manifest/1.1.0",
  "title": "Research Mission Manifest",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "mission_id",
    "mission_name",
    "mission_type",
    "mission_template_id",
    "mission_template_version",
    "parent_twin_id",
    "baseline_release",
    "created_date",
    "generated_date",
    "owner",
    "governance_state",
    "scope",
    "profile_pins",
    "relationship_profile_versions",
    "evidence_uncertainty_profile_versions",
    "release_manifest_version",
    "research_priorities",
    "evidence_policy",
    "estimation_policy",
    "outputs",
    "outcome_states",
    "pack_version"
  ],
  "properties": {
    "schema_id": {
      "const": "CIOS-Research-Mission-Manifest"
    },
    "schema_version": {
      "const": "1.1.0"
    },
    "mission_id": {},
    "mission_name": {},
    "mission_type": {
      "enum": [
        "industry-twin-construction",
        "industry-twin-continuation",
        "targeted-evidence-closure",
        "commercial-pipeline-qualification",
        "opportunity-pipeline-enrichment",
        "enterprise-dossier-enrichment",
        "market-participant-enrichment",
        "reinvention-assessment-enrichment",
        "periodic-twin-refresh",
        "monitoring-trigger-update"
      ]
    },
    "mission_template_id": {},
    "mission_template_version": {},
    "parent_twin_id": {},
    "baseline_release": {},
    "created_date": {},
    "generated_date": {},
    "owner": {},
    "governance_state": {},
    "scope": {},
    "profile_pins": {},
    "relationship_profile_versions": {},
    "evidence_uncertainty_profile_versions": {},
    "release_manifest_version": {},
    "research_priorities": {},
    "evidence_policy": {},
    "estimation_policy": {},
    "outputs": {},
    "outcome_states": {
      "type": "array",
      "items": {
        "enum": [
          "CONTINUE",
          "EVIDENCE_EXHAUSTED",
          "COMPLETE"
        ]
      }
    },
    "pack_version": {},
    "commercial_pipeline_configuration": {
      "type": "object"
    },
    "predecessor_mission_id": {}
  }
}
