{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-mission-manifest-v1", "title": "Research Mission Manifest",
  "type": "object", "additionalProperties": false,
  "required": ["manifest_version","mission_id","mission_type","parent_twin_id","industry","geography","baseline_release","scope","profile_versions","research_priorities","required_outputs","evidence_closure_policy","permitted_estimate_types","outcome_states","generated_date","pack_version"],
  "properties": {
    "manifest_version":{"const":"1.0.0"}, "mission_id":{"type":"string","minLength":1},
    "mission_type":{"enum":["industry-twin-construction","industry-twin-continuation","targeted-evidence-closure","opportunity-pipeline-enrichment","periodic-twin-refresh"]},
    "parent_twin_id":{"type":"string","minLength":1}, "industry":{"type":"string","minLength":1},
    "geography":{"type":"array","minItems":1,"items":{"type":"string"}}, "baseline_release":{"type":"string","minLength":1},
    "scope":{"type":"object","minProperties":1}, "profile_versions":{"type":"object","minProperties":1,"additionalProperties":{"type":"string"}},
    "research_priorities":{"type":"array","minItems":1,"items":{"type":"string"}}, "required_outputs":{"type":"array","minItems":1,"items":{"type":"string"}},
    "horizon_definitions":{"type":"object","additionalProperties":{"type":"string"}}, "evidence_closure_policy":{"type":"string","minLength":1},
    "permitted_estimate_types":{"type":"array","items":{"enum":["none","bounded-range","derived","analyst-scenario"]}},
    "outcome_states":{"type":"array","minItems":1,"items":{"enum":["COMPLETE","CONTINUE","EVIDENCE EXHAUSTED"]}},
    "generated_date":{"type":"string","format":"date-time"}, "pack_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "current_gaps":{"type":"array","items":{"type":"string"}}, "subject_ids":{"type":"array","items":{"type":"string"}}, "approved_brief_reference":{"type":"string"}
  }
}
